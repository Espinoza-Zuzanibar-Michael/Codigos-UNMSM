#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main() {
    ifstream archivo("productos.txt");
    string producto;
    float precio, descuento, precioFinal;

    cout << "--- Descuento a Productos desde Archivo ---\n";
    cout << "Ingrese el porcentaje de descuento a aplicar (ej. 15 para 15%): ";
    cin >> descuento;

    if (!archivo.is_open()) {
        cout << "Error: No se encontró 'productos.txt'." << endl;
        return 1;
    }

    cout << "\nReporte de Precios con " << descuento << "% de descuento:\n";
    cout << "--------------------------------------------------\n";
    
    while (archivo >> producto >> precio) {
        // Cálculo del precio final
        precioFinal = precio - (precio * (descuento / 100.0f));
        cout << "Producto: " << producto 
             << " | Precio original: S/" << precio 
             << " | Precio final: S/" << precioFinal << endl;
    }

    archivo.close();
    return 0;
}
