#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    float nota, suma = 0.0f;
    vector<float> notas;

    cout << "--- Promedio de Notas --- \n";
    cout << "¿Cuántas notas desea ingresar?: ";
    cin >> n;

    if (n <= 0) {
        cout << "Cantidad inválida." << endl;
        return 1;
    }

    cout << "Ingrese las " << n << " notas:\n";
    for (int i = 0; i < n; ++i) {
        cout << "Nota " << i + 1 << ": ";
        cin >> nota;
        notas.push_back(nota);
        suma += nota;
    }

    float promedio = suma / n;
    cout << "El promedio de las notas es: " << promedio << endl;

    return 0;
}
