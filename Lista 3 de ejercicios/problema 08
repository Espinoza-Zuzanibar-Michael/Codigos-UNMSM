#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n, m;

    cout << "--- Transposición de Matriz ---\n";
    cout << "Ingrese el número de filas (n): ";
    cin >> n;
    cout << "Ingrese el número de columnas (m): ";
    cin >> m;

    if (n <= 0 || m <= 0) return 1;

    // Matriz original n x m
    vector<vector<int>> matriz(n, vector<int>(m));
    // Matriz transpuesta m x n
    vector<vector<int>> transpuesta(m, vector<int>(n));

    cout << "Ingrese los elementos de la matriz:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> matriz[i][j];
        }
    }

    // Calculando la transpuesta: las filas se vuelven columnas
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            transpuesta[j][i] = matriz[i][j];
        }
    }

    cout << "\nMatriz Transpuesta (" << m << "x" << n << "):\n";
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cout << transpuesta[i][j] << " ";
        }
        cout << "\n";
    }

    return 0;
}
