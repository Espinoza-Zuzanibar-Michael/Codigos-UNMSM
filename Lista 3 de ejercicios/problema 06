#include <iostream>
#include <string>

using namespace std;

// Función que implementa Bubble Sort en un string
void bubbleSort(string& texto) {
    int n = texto.length();
    bool intercambiado;

    for (int i = 0; i < n - 1; i++) {
        intercambiado = false;
        // En cada iteración 'i', los últimos 'i' elementos ya están ordenados
        for (int j = 0; j < n - i - 1; j++) {
            if (texto[j] > texto[j + 1]) {
                // Intercambio usando una variable temporal
                char temp = texto[j];
                texto[j] = texto[j + 1];
                texto[j + 1] = temp;
                intercambiado = true;
            }
        }
        // Si no hubo intercambios en esta pasada, ya está ordenado
        if (!intercambiado) break;
    }
}

int main() {
    string cadena;

    cout << "--- Ordenamiento Burbuja en Cadena ---\n";
    cout << "Ingrese una cadena de caracteres sin espacios: ";
    cin >> cadena;

    cout << "\nCadena original: " << cadena << endl;
    bubbleSort(cadena);
    cout << "Cadena ordenada: " << cadena << endl;

    return 0;
}
