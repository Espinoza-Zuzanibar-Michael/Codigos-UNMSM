    ofstream archivoSalida("tercio_superior.txt");
    archivoSalida << "--- TERCIO SUPERIOR ---\n";
    for (const auto& est : tercioSuperior) {
        archivoSalida << est.nombre << "\t" << est.promedio << "\n";
    }
    archivoSalida.close();

    cout << "\nArchivo 'tercio_superior.txt' generado exitosamente.\n";
    return 0;
}
