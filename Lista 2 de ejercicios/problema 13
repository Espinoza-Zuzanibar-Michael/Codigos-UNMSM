#include <iostream>
int main() {
int sumaPares = 0;
int sumaImpares = 0;
for (int i = 1; i <= 200; ++i) {
if (i % 2 == 0) {
sumaPares += i;
} else {
sumaImpares += i;
}
}
std::cout << "Suma de pares: " << sumaPares << std::endl;
std::cout << "Suma de impares: " << sumaImpares << 
std::endl;
return 0;
}
