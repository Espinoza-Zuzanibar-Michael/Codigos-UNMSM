#include <iostream>
int main() {
    int n;
    std::cout << "Introduzca un entero positivo: ";
    if (!(std::cin >> n) || n < 0) {
        std::cout << "Entrada no valida." << std::endl;
        return 1;
    }
    unsigned long long factorial = 1;
    int i = 1;
    
    while (i <= n) {
        factorial *= i;
        i++;
    }
    std::cout << "El factorial de " << n << " es: " << 
factorial << std::endl;
return 0;
}
