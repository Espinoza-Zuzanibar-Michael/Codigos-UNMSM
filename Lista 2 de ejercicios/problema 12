#include <iostream>
#include <iomanip>
void procesar(int n, bool cifrar) {
    int d[4];
    d[0] = (n / 1000) % 10;
    d[1] = (n / 100) % 10;
    d[2] = (n / 10) % 10;
    d[3] = n % 10;
    if (cifrar) {
        for(int i=0; i<4; i++) d[i] = (d[i] + 7) % 10;
        std::cout << "Cifrado: " << d[2] << d[3] << d[0] << 
d[1] << std::endl;
    } else {
        int r[4];
        r[0] = (d[2] + 3) % 10;
        r[1] = (d[3] + 3) % 10;
        r[2] = (d[0] + 3) % 10;
        r[3] = (d[1] + 3) % 10;
        std::cout << "Descifrado: " << r[0] << r[1] << r[2] << 
r[3] << std::endl;
    }
}
int main() {
    int opcion, num;
    std::cout << "1. Cifrar\n2. Descifrar\nSeleccion: ";
    std::cin >> opcion;
    std::cout << "Numero: ";
    std::cin >> num;

Prueba de escritorio:
    procesar(num, opcion == 1);
    return 0;
}
