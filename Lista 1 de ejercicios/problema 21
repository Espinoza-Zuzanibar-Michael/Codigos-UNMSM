#include <iostream>

int main() {
    int n;
    std::cout << "Introduce el numero de filas para el triangulo: ";
    std::cin >> n;

    // Bucle para las filas
    for (int i = 1; i <= n; i++) {
        // Bucle para las columnas
        for (int j = 1; j <= i; j++) {
            std::cout << j << " ";
        }
        std::cout << "\n"; // Salto de línea al terminar la fila
    }

    return 0;
}
