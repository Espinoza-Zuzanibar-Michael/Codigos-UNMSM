#include <iostream>
#include <string>

int main() {
    std::string num_str;
    std::cout << "Introduce un numero entero: ";
    std::cin >> num_str;

    std::string resultado = "";
    int acarreo = 0;

    // back() extrae el último caracter del string
    resultado += num_str.back();

    // Recorremos de derecha a izquierda
    for (int i = num_str.length() - 1; i > 0; i--) {
        // Restar '0' convierte el caracter a su valor numérico real
        int d1 = num_str[i] - '0';
        int d2 = num_str[i - 1] - '0';
        int suma = d1 + d2 + acarreo;

        // Se inserta por la izquierda (índice 0)
        resultado.insert(0, std::to_string(suma % 10));
        acarreo = suma / 10;
    }

    // Insertamos el dígito más significativo
    int primer_digito = (num_str[0] - '0') + acarreo;
    resultado.insert(0, std::to_string(primer_digito));

    std::cout << "El producto por 11 es: " << resultado << "\n";

    return 0;
}
