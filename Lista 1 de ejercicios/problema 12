#include <iostream>
#include <string>

int main() {
    int num;
    std::cout << "Introduce un numero del 1 al 20: ";
    std::cin >> num;

    if (num < 1 || num > 20) {
        std::cout << "Error: El numero esta fuera del rango.\n";
    } else {
        // Arreglo de strings para mapeo directo
        std::string romanos[] = {"", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", 
                                 "XI", "XII", "XIII", "XIV", "XV", "XVI", "XVII", "XVIII", "XIX", "XX"};
        
        std::cout << "El numero en romano es: " << romanos[num] << "\n";
    }

    return 0;
}
