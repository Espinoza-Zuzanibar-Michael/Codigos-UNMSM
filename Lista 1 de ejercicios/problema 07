#include <iostream>
#include <cstdlib>
#include <ctime>

int main() {
    int MAXIMO = 100;
    
    // Inicializamos la semilla para los números aleatorios
    std::srand(std::time(0));
    int numero = (std::rand() % MAXIMO) + 1;
    
    bool acierto = false;
    int intentos = 0;
    int n;

    while (!acierto) {
        std::cout << "Introduzca un numero: ";
        std::cin >> n;
        intentos++;

        if (n == numero) {
            acierto = true;
            std::cout << "¡¡acertaste!!\n";
        } else if (n < numero) {
            std::cout << "El numero es mayor\n";
        } else {
            std::cout << "El numero es menor\n";
        }
    }

    // Imprimimos el total de intentos tal como pide el ejercicio
    std::cout << "Numero de intentos: " << intentos << "\n";

    return 0;
}
