#include <iostream>
#include <string>
#include <map>

int main() {
    std::string binario;
    std::cout << "Introduce un numero binario: ";
    std::cin >> binario;

    // Mapa para la traduccion directa
    std::map<std::string, char> mapa_hex = {
        {"0000", '0'}, {"0001", '1'}, {"0010", '2'}, {"0011", '3'},
        {"0100", '4'}, {"0101", '5'}, {"0110", '6'}, {"0111", '7'},
        {"1000", '8'}, {"1001", '9'}, {"1010", 'A'}, {"1011", 'B'},
        {"1100", 'C'}, {"1101", 'D'}, {"1110", 'E'}, {"1111", 'F'}
    };

    // Calculamos cuantos ceros faltan para ser multiplo de 4
    int faltan = binario.length() % 4;
    if (faltan != 0) {
        binario.insert(0, 4 - faltan, '0');
    }

    std::string hexadecimal = "";
    
    // Extraccion de subcadenas (substr) de tamaño 4
    for (size_t i = 0; i < binario.length(); i += 4) {
        std::string grupo = binario.substr(i, 4);
        hexadecimal += mapa_hex[grupo];
    }

    std::cout << "El numero hexadecimal es: " << hexadecimal << "\n";
    
    return 0;
}
